# Supabase: Project Settings > API. Both are safe for the browser (the anon key is limited by RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Option A: local model through LM Studio (Developer tab, start server). Local development only.
# If OPENAI_BASE_URL is set, it is used instead of Gemini.
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=your-lm-studio-api-token
# OPENAI_MODEL=exact-model-id-shown-in-lm-studio

# Option B: Gemini (works when deployed). https://aistudio.google.com/apikey. Server only. Never prefix with VITE_.
GEMINI_API_KEY=your-gemini-key
# Optional: override the model
# GEMINI_MODEL=gemini-3.1-flash-lite
